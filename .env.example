# Copier ce fichier en .env.local et compléter. Ne jamais committer .env.local.

# URL publique du site (sitemap, Open Graph, robots.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresse e-mail de contact affichée au public (laisser vide tant qu'elle n'existe pas)
NEXT_PUBLIC_CONTACT_EMAIL=

# Autoriser l'indexation par les moteurs de recherche (mettre "true" uniquement en production validée)
NEXT_PUBLIC_ALLOW_INDEXING=false

# Supabase (espace admin + enregistrement des demandes). Laisser vide = mode sans base.
# Supabase > Project Settings > API : "Project URL" et clé "anon public" (jamais la clé service_role).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Acheminement des formulaires (contact, rendez-vous) : "console" ou "webhook"
# Avec Supabase, les demandes sont enregistrées en base ; "webhook" envoie alors seulement
# une notification SANS donnée personnelle (type, référence, lien vers l'admin).
# - console : affiche la demande dans le terminal (développement uniquement)
# - webhook : POST JSON vers FORMS_WEBHOOK_URL
# En production sans valeur, les formulaires affichent un message d'indisponibilité.
FORMS_DELIVERY=console
FORMS_WEBHOOK_URL=
# Facultatif : envoyé en en-tête "Authorization: Bearer ..." (secret côté serveur uniquement)
FORMS_WEBHOOK_SECRET=

# Google Search Console : code de vérification (balise meta), à renseigner lors de l'ouverture à Google
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Secret des liens clients vers les guides privés (une longue phrase de votre choix)
GUIDES_LINK_SECRET=
